# mcp-ms-office-documents configuration (ALL optional — server starts with
# zero env vars: LOCAL file output, no auth). Copy to .env to override.

# Where generated files go: LOCAL (default) | S3 | GCS | AZURE | MINIO
#UPLOAD_STRATEGY=LOCAL

# Require "Authorization: Bearer <key>" on the MCP endpoint (recommended once
# the server is reachable by anything other than localhost)
#API_KEY=change-me

# Signed-URL validity when using cloud storage (seconds)
#SIGNED_URL_EXPIRES_IN=3600

# Template-admin UI at http://localhost:8958/admin (create/edit templates in
# the browser; each template becomes an MCP tool live, no restart)
#ADMIN_ENABLED=true
#ADMIN_PASSWORD=change-me

# Verbose logging
#DEBUG=true

# --- Cloud storage (only if UPLOAD_STRATEGY is not LOCAL) ---
#S3_BUCKET=            AWS_ACCESS_KEY=  AWS_SECRET_ACCESS_KEY=  AWS_REGION=
#GCS_BUCKET=           GCS_CREDENTIALS_PATH=
#AZURE_STORAGE_ACCOUNT_NAME=  AZURE_STORAGE_ACCOUNT_KEY=  AZURE_CONTAINER=
#MINIO_ENDPOINT=  MINIO_ACCESS_KEY=  MINIO_SECRET_KEY=  MINIO_BUCKET=
